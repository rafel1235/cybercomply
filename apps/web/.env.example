NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-real-anon-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Sentry (Fase 9 — error tracking in produzione) ---
# Senza NEXT_PUBLIC_SENTRY_DSN, il monitoraggio è completamente disattivato (nessuna
# chiamata di rete, nessun costo di build aggiuntivo — vedi next.config.js). Ambiente
# mostrato nella dashboard Sentry per distinguere gli eventi di staging da quelli di
# produzione.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ENVIRONMENT=development
# Necessari solo per l'upload dei source map in fase di build (facoltativo, richiede un
# token generato dalla dashboard Sentry): senza SENTRY_AUTH_TOKEN l'upload viene saltato,
# la build funziona comunque.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
