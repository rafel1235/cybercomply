# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cybercomplyit

# --- Supabase (Auth) ---
# Da compilare con i valori reali del progetto Supabase quando disponibili.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=replace-with-real-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-real-service-role-key
SUPABASE_JWT_SECRET=replace-with-real-jwt-secret

# --- App ---
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000
LOGIN_RATE_LIMIT=10/15minutes

# --- Anthropic (Fase 5 — generazione documenti con AI) ---
# Senza una chiave reale, la generazione documenti usa automaticamente il contenuto
# segnaposto strutturato (nessun errore, solo niente testo scritto dall'AI).
ANTHROPIC_API_KEY=replace-with-real-key-when-fase-5-inizia
ANTHROPIC_MODEL=claude-sonnet-5
# Prezzi per milione di token (USD): lasciati a 0 finché non li imposti con i valori reali
# correnti dalla pagina pricing di Anthropic. A 0, il log di ogni chiamata riporta i token
# usati ma non un costo stimato in USD.
ANTHROPIC_INPUT_COST_PER_MTOK=0
ANTHROPIC_OUTPUT_COST_PER_MTOK=0

# --- Stripe (Fase 6 — pagamenti e piani) ---
# Senza chiave reale, checkout/portale rispondono con un errore chiaro invece di un 500;
# il resto della piattaforma (limiti di piano, trial, downgrade) funziona comunque.
STRIPE_SECRET_KEY=replace-with-real-key-when-fase-6-inizia
STRIPE_PUBLISHABLE_KEY=replace-with-real-publishable-key
STRIPE_WEBHOOK_SECRET=replace-with-real-webhook-secret
STRIPE_PRICE_ID_ESSENTIAL=replace-with-real-price-id
STRIPE_PRICE_ID_BUSINESS=replace-with-real-price-id
FRONTEND_BASE_URL=http://localhost:3000

# --- Resend (Fase 7 — email transazionali) ---
# Senza chiave reale, le email non vengono inviate: si logga soltanto (nessun errore,
# nessun flusso bloccato — registrazione, inviti e webhook di pagamento funzionano
# comunque). Il dominio del mittente va verificato su Resend con SPF/DKIM/DMARC prima del
# lancio commerciale, altrimenti le email finiscono in spam o vengono rifiutate.
RESEND_API_KEY=replace-with-real-key-when-fase-7-inizia
EMAIL_FROM_ADDRESS=CyberComplyIT <noreply@cybercomplyit.it>

# --- Cifratura campi sensibili a riposo (Fase 8) ---
# Genera una chiave reale con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATTENZIONE: senza questa chiave, P.IVA e dati incidenti vengono salvati IN CHIARO (solo
# loggato un avviso, nessun errore). Una volta impostata, non perderla e non cambiarla
# senza prima decifrare i dati esistenti: i dati cifrati con la vecchia chiave
# diventerebbero illeggibili per sempre.
FIELD_ENCRYPTION_KEY=replace-with-real-fernet-key-when-fase-8-inizia

# --- Storage PDF (Fase 9) ---
# Riusa le credenziali Supabase già impostate sopra (SUPABASE_URL + service role key):
# se sono valide, i PDF generati vengono caricati sul bucket indicato invece che salvati
# su disco locale (necessario su host con filesystem effimero come Render). Il bucket
# deve già esistere sul progetto Supabase reale.
SUPABASE_STORAGE_BUCKET=documents

# --- Sentry (Fase 9 — error tracking in produzione) ---
# Senza un DSN reale, il monitoraggio è semplicemente disattivato (nessun errore, nessuna
# chiamata di rete). Il DSN si ottiene creando un progetto su sentry.io (piano gratuito
# sufficiente all'inizio) — vedi docs/AMBIENTI.md.
SENTRY_DSN=replace-with-real-dsn-when-fase-9-inizia
